PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@abencivobiotech.com
ADMIN_PASSWORD=change-this-password
CORS_ORIGIN=http://localhost:5173

# Company details - edit these in src/config.js for the frontend
# Email integration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
MAIL_FROM_NAME=Abencivo Biotech

# Who gets notified for each enquiry type. Leave an email blank to fall
# back to MAIL_TO above — nothing is ever silently dropped.
FRANCHISE_MANAGER_NAME=Franchise Manager
FRANCHISE_MANAGER_EMAIL=
MANUFACTURING_MANAGER_NAME=Manufacturing Manager
MANUFACTURING_MANAGER_EMAIL=
SALES_MANAGER_NAME=Sales Manager
SALES_MANAGER_EMAIL=
GENERAL_MANAGER_NAME=Customer Care

# WhatsApp number, digits only, country code included
WHATSAPP_NUMBER=91XXXXXXXXXX
